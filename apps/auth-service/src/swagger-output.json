{
  "swagger": "2.0",
  "info": {
    "title": "Auth Service",
    "description": "Auth Service API",
    "version": "1.0.0"
  },
  "host": "localhost:6001",
  "basePath": "/",
  "schemes": ["http"],
  "paths": {
    "/api/user-registration": {
      "post": {
        "description": "Register a new user and send OTP to email",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["name", "email", "password"],
              "properties": {
                "name": {
                  "type": "string",
                  "example": "Manh Tran Duc"
                },
                "email": {
                  "type": "string",
                  "example": "manhtranduc0202@gmail.com"
                },
                "password": {
                  "type": "string",
                  "example": "Password123!"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OTP sent successfully",
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "example": true
                },
                "message": {
                  "type": "string",
                  "example": "Otp sent to your email. Please check your inbox."
                }
              }
            }
          }
        }
      }
    }
  }
}
